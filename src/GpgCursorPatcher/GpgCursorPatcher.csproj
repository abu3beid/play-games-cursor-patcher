<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GpgCursorPatcher</AssemblyName>
    <RootNamespace>GpgCursorPatcher</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Play Games Cursor Patcher</Product>
    <Description>Replaces the 64x64 cursor Google Play Games draws over a game.</Description>

    <!-- Rewriting crosvm.exe under Program Files needs elevation, and the app is
         useless without it, so ask up front rather than failing at the last step. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

</Project>
