<Window x:Class="GpgCursorPatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Play Games Cursor Patcher"
        Width="620" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- installation -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="8" Padding="16,13">
            <StackPanel>
                <TextBlock Text="GOOGLE PLAY GAMES" Style="{StaticResource Heading}"/>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontSize="14" Text="Looking for the installation…"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- cursors -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="16,13">
                <StackPanel>
                    <TextBlock Text="IN CROSVM.EXE NOW" Style="{StaticResource Heading}"/>
                    <Border Height="96" Margin="0,10,0,0" CornerRadius="6" Background="#12141A">
                        <Image x:Name="CurrentPreview" Width="64" Height="64"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="16,13">
                <StackPanel>
                    <TextBlock Text="REPLACEMENT" Style="{StaticResource Heading}"/>
                    <Border Height="96" Margin="0,10,0,0" CornerRadius="6" Background="#12141A">
                        <Grid>
                            <TextBlock x:Name="NoImageText" Text="nothing chosen" Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="NewPreview" Width="64" Height="64"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- chooser + hotspot -->
        <Border Grid.Row="2" Margin="0,14,0,0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,13">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BrowseButton" Content="Choose image…" Click="OnBrowse"/>
                    <TextBlock Grid.Column="1" x:Name="FileText" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                               Text="PNG, ICO or CUR — scaled to 64×64"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                    <TextBlock Text="Hotspot" VerticalAlignment="Center"/>
                    <TextBlock Text="X" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,5,0"/>
                    <TextBox x:Name="HotspotXBox" Text="0" Width="52" TextAlignment="Center" TextChanged="OnHotspotChanged"/>
                    <TextBlock Text="Y" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox x:Name="HotspotYBox" Text="0" Width="52" TextAlignment="Center" TextChanged="OnHotspotChanged"/>
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="the pixel that actually points — 0,0 is the top-left"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- actions -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="RestoreButton" Content="Restore original" Click="OnRestore"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="Apply cursor" Click="OnApply"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="MessageText" Margin="0,14,0,0" TextWrapping="Wrap"
                   Style="{StaticResource Muted}"
                   Text="Set the in-game cursor to one of the large options — on “default” the game draws the Windows pointer instead."/>
    </Grid>
</Window>
